#!/usr/bin/env python3
"""Read WhatsApp Desktop's local database. Read only, never sends."""
import os, sys, sqlite3, subprocess

DB = os.path.expanduser('~/Library/Group Containers/group.net.whatsapp.WhatsApp.shared/ChatStorage.sqlite')
MEDIA = os.path.expanduser('~/Library/Group Containers/group.net.whatsapp.WhatsApp.shared/Message')

TYPE = {0: 'text', 1: 'image', 2: 'video', 3: 'VOICE', 4: 'contact', 5: 'location',
        6: 'system', 7: 'link', 8: 'doc', 10: 'call', 11: 'gif', 13: 'sticker',
        14: 'DELETED', 15: 'sticker', 66: 'poll'}


def conn():
    if not os.path.exists(DB):
        sys.exit('WhatsApp database not found. Is WhatsApp Desktop installed and signed in?')
    return sqlite3.connect('file:%s?mode=ro' % DB, uri=True)


# --- just enough protobuf to read the reaction blob ---
def _varint(b, i):
    v = s = 0
    while i < len(b):
        c = b[i]; i += 1
        v |= (c & 0x7F) << s
        if not c & 0x80:
            return v, i
        s += 7
    return v, i


def _fields(b):
    i = 0
    while i < len(b):
        try:
            key, i = _varint(b, i)
        except Exception:
            return
        fn, wt = key >> 3, key & 7
        if wt == 0:
            v, i = _varint(b, i); yield fn, wt, v
        elif wt == 2:
            ln, i = _varint(b, i)
            if i + ln > len(b):
                return
            yield fn, wt, b[i:i + ln]; i += ln
        elif wt == 5:
            i += 4
        elif wt == 1:
            i += 8
        else:
            return


def parse_reactions(blob):
    """ZRECEIPTINFO field 7 carries the reactions. Returns [(jid, emoji)]."""
    out = []
    if not blob:
        return out
    for fn, wt, val in _fields(bytes(blob)):
        if fn != 7 or wt != 2:
            continue
        for _, swt, sval in _fields(val):
            if swt != 2:
                continue
            jid = emoji = None
            for tfn, twt, tval in _fields(sval):
                if twt != 2:
                    continue
                if tfn == 2:
                    jid = tval.decode('utf8', 'ignore')
                elif tfn == 3:
                    emoji = tval.decode('utf8', 'ignore')
            if emoji:
                out.append((jid or '?', emoji))
    return out


def name_of(c, jid):
    if not jid:
        return '?'
    r = c.execute("SELECT ZPARTNERNAME FROM ZWACHATSESSION WHERE ZCONTACTJID=?", (jid,)).fetchone()
    if r:
        return r[0]
    r = c.execute("SELECT ZCONTACTNAME FROM ZWAGROUPMEMBER WHERE ZMEMBERJID=? AND ZCONTACTNAME IS NOT NULL LIMIT 1", (jid,)).fetchone()
    return (r[0] if r and r[0] else jid)


def show(c, rows):
    for pk, when, mine, mtype, who, txt in rows:
        kind = TYPE.get(mtype, 't%s' % mtype)
        sender = 'ME' if mine else (who or 'THEM')
        print('pk%-9d %s  %-9s %-18s %s' % (pk, when[5:16], kind, sender[:18], (txt or '').replace('\n', ' ')[:160]))


def fetch(c, session, limit, only_incoming_after_last_ours=False):
    where = "m.ZCHATSESSION=?"
    args = [session]
    if only_incoming_after_last_ours:
        last = c.execute("SELECT COALESCE(MAX(Z_PK),0) FROM ZWAMESSAGE WHERE ZCHATSESSION=? AND ZISFROMME=1", (session,)).fetchone()[0]
        where += " AND m.ZISFROMME=0 AND m.Z_PK>?"
        args.append(last)
    q = """SELECT m.Z_PK, datetime(m.ZMESSAGEDATE+978307200,'unixepoch','localtime'),
                  m.ZISFROMME, m.ZMESSAGETYPE, COALESCE(gm.ZCONTACTNAME,''), COALESCE(m.ZTEXT,'')
           FROM ZWAMESSAGE m LEFT JOIN ZWAGROUPMEMBER gm ON gm.Z_PK=m.ZGROUPMEMBER
           WHERE %s ORDER BY m.Z_PK DESC LIMIT ?""" % where
    args.append(limit)
    return list(reversed(c.execute(q, args).fetchall()))


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        print('usage: wa chats | find <text> | read <session> [n] | unread <session> | reactions <session> | media <pk>')
        return
    cmd = sys.argv[1]
    c = conn()

    if cmd == 'chats':
        rows = c.execute("""SELECT Z_PK, ZPARTNERNAME, ZCONTACTJID,
                            datetime(ZLASTMESSAGEDATE+978307200,'unixepoch','localtime')
                            FROM ZWACHATSESSION
                            WHERE ZLASTMESSAGEDATE IS NOT NULL
                              AND ZCONTACTJID NOT LIKE '%.status'
                              AND ZCONTACTJID NOT LIKE '%newsletter'
                            ORDER BY ZLASTMESSAGEDATE DESC LIMIT 30""").fetchall()
        for pk, name, jid, last in rows:
            kind = 'group' if (jid or '').endswith('@g.us') else 'chat'
            print('%-6d %-6s %-34s %s' % (pk, kind, (name or '?')[:34], last[5:16]))

    elif cmd == 'find':
        term = sys.argv[2].lower()
        rows = c.execute("""SELECT Z_PK, ZPARTNERNAME, ZCONTACTJID,
                            datetime(ZLASTMESSAGEDATE+978307200,'unixepoch','localtime')
                            FROM ZWACHATSESSION WHERE lower(ZPARTNERNAME) LIKE ?
                            AND ZCONTACTJID NOT LIKE '%.status'
                            ORDER BY ZLASTMESSAGEDATE DESC LIMIT 15""", ('%' + term + '%',)).fetchall()
        for pk, name, jid, last in rows:
            print('%-6d %-34s %-32s %s' % (pk, (name or '?')[:34], jid, (last or '')[5:16]))

    elif cmd in ('read', 'unread'):
        s = int(sys.argv[2])
        n = int(sys.argv[3]) if len(sys.argv) > 3 else 30
        nm = c.execute("SELECT ZPARTNERNAME FROM ZWACHATSESSION WHERE Z_PK=?", (s,)).fetchone()
        print('### %s (session %d)' % (nm[0] if nm else '?', s))
        show(c, fetch(c, s, n, only_incoming_after_last_ours=(cmd == 'unread')))

    elif cmd == 'reactions':
        s = int(sys.argv[2])
        rows = c.execute("""SELECT m.Z_PK, m.ZISFROMME, COALESCE(m.ZTEXT,''), m.ZMESSAGETYPE, i.ZRECEIPTINFO
                            FROM ZWAMESSAGE m JOIN ZWAMESSAGEINFO i ON i.ZMESSAGE=m.Z_PK
                            WHERE m.ZCHATSESSION=? ORDER BY m.Z_PK DESC LIMIT 120""", (s,)).fetchall()
        for pk, mine, txt, mtype, blob in rows:
            for jid, emo in parse_reactions(blob):
                label = txt[:60] if txt else '(' + TYPE.get(mtype, '?') + ')'
                print('pk%-9d %s reacted %s to %s: %s' % (pk, name_of(c, jid), emo, 'OUR' if mine else 'their', label))

    elif cmd == 'media':
        pk = int(sys.argv[2])
        r = c.execute("""SELECT mi.ZMEDIALOCALPATH, m.ZMESSAGETYPE FROM ZWAMESSAGE m
                         JOIN ZWAMEDIAITEM mi ON mi.ZMESSAGE=m.Z_PK WHERE m.Z_PK=?""", (pk,)).fetchone()
        if not r or not r[0]:
            sys.exit('no media on message %d' % pk)
        path = os.path.join(MEDIA, r[0])
        print(path if os.path.exists(path) else 'not downloaded yet: ' + path)

    else:
        sys.exit('unknown command: ' + cmd)


if __name__ == '__main__':
    main()
